<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">

    <!-- CSS -->
    <link rel="preload" href="/assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
    {% if modernHome %}<link rel="stylesheet" href="/assets/ui/home.css?v={{ uiVersion }}">{% else %}<link rel="stylesheet" href="/assets/css/main.css?v=20260919-single-page-posters">{% endif %}

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">

    <!-- SEO Meta Tags -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
    {% if tags %}<meta name="keywords" content="{% for t in tags %}{{ t | stripTags }}{% if not loop.last %}, {% endif %}{% endfor %}">{% endif %}
    <meta name="author" content="{% if name %}{{ name }}{% else %}{{ site.author.name }}{% endif %}">

    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta property="og:type" content="{% if publications %}profile{% else %}website{% endif %}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}/assets/ms_light.png">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@{{ site.author.twitter }}">
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
    <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <meta name="twitter:image" content="{{ site.url }}/assets/ms_light.png">

    <!-- Structured data -->
    {% if publications %}
    <script type="application/ld+json">{{ name | personLd(affiliation, page.url, publications, links, site.url, tags) | safe }}</script>
    {% elif page.url == "/" %}
    <script type="application/ld+json">{{ site | orgLd | safe }}</script>
    {% endif %}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NVVE0ER640"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NVVE0ER640');
    </script>
</head>
<body>
    {% if modernHome %}{{ content | safe }}{% else %}
    <header class="site-header">
      <a class="site-brand" href="/" aria-label="Mathscapes home">
        <img src="/assets/ms_light.png" alt="Mathscapes" class="site-logo site-logo--light">
        <img src="/assets/ms_dark.png" alt="Mathscapes" class="site-logo site-logo--dark">
      </a>
    </header>
    <main id="main">
        {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    {% endif %}

</body>
</html>
