---
layout: base.njk
---

<div class="person" style="--accent: {{ accent or '#0000ee' }}">

  <div class="person-heading">
    <h1 class="person-name">{{ name }}</h1>
    {% if affiliation %}<span class="affiliation">{{ affiliation | safe }}</span>{% endif %}
  </div>

  {% if bio %}<p class="person-bio">{{ bio | safe }}</p>{% endif %}

  {% if links %}
  <div class="cta-wrapper profile-links">
    {% for link in links %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
  </div>
  {% endif %}

  {% if tags %}
  <div class="tag-row" aria-label="Areas of expertise">
    {% for t in tags %}<span class="tag">{{ t }}</span>{% endfor %}
  </div>
  {% endif %}

  <div class="pub-summary" aria-label="Publication summary">
    <span>{{ publications | length }} publications</span>
    <span>{{ (publications | last).year }}&ndash;{{ (publications | first).year }} active</span>
  </div>

  <h2>Publications</h2>

  <div class="pub-timeline">
    {% for group in publications | groupByYear %}
    <div class="pub-year-group">
      <div class="pub-year-label">{{ group.year }}</div>
      <div class="pub-year-items">
        {% for pub in group.items %}
        <div class="publication">

          <div class="pub-info">
            {% if pub.url %}<a class="pub-title" href="{{ pub.url }}">{{ pub.title }}</a>{% else %}<span class="pub-title">{{ pub.title }}</span>{% endif %}
            <div class="pub-details">
              <div class="pub-venue">{{ pub.venue }}</div>
              <div class="pub-authors" aria-label="Authors">{{ pub.authors | authorBadges | safe }}</div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  {{ content | safe }}

</div>
